import { ViewTransition, startTransition, useState } from "octane";

setup const [open, setOpen] = useState(false);
setup const toggle = () => startTransition(() => setOpen((value) => !value));

div(className="flex w-full flex-col items-center gap-8")
  // One outer name morphs the frame; the inner names morph their own pieces.
  div(className='min-h-80')
    ViewTransition(name="b-card" update="glide" share="glide")
      if open
        article(className="w-full max-w-md cursor-pointer rounded-[1.75rem] bg-panel-2 p-4" onClick={toggle})
          ViewTransition(name="b-card-art" share="morph" update='morph')
            div(className="art art-2 h-44 rounded-[1.25rem]")
          div(className="flex items-end justify-between gap-4 px-2 pt-5")
            ViewTransition(name="b-card-title" share="glide")
              h3(className="m-0 text-2xl font-medium tracking-[-0.03em]") Harbour 6:12 PM
            span(className='chip') 35mm
          p(className="m-0 px-2 pt-3 pb-2 text-sm leading-relaxed text-muted") Low tide, cold light, one ferry waiting. The same element, re-laid out — no second component, no keyframes of our own.
      else
        article(className="flex w-72 cursor-pointer items-center gap-3 rounded-full bg-panel-2 p-2 pr-6" onClick={toggle})
          ViewTransition(name="b-card-art" share="morph")
            div(className="art art-2 size-14 rounded-full")
          ViewTransition(name="b-card-title" share="glide")
            h3(className="m-0 text-base font-medium") Harbour, 06:12
  button(type="button" aria-pressed={open} onClick={toggle} className='vt-btn') #{open ? "collapse" : "expand"}
