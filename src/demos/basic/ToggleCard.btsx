import { ViewTransition, addTransitionType, startTransition, useState } from "octane";
module
  // Grow while expanding, shrink while collapsing: each keeps only the larger
  // snapshot, clipped to the moving box, so nothing balloons or double-fades.
  const FRAME = { expand: "unfold", collapse: "fold" };
  const ART = { expand: "grow", collapse: "shrink" };

setup const [open, setOpen] = useState(false);
setup
  const toggle = () => startTransition(() => {
    addTransitionType(open ? "collapse" : "expand");
    setOpen((value) => !value);
  });

div(className="flex w-full flex-col items-center gap-8")
  // One outer name morphs the frame; the inner names morph their own pieces.
  div(className='min-h-80')
    ViewTransition(name="b-card" update={FRAME})
      if open
        article(className="w-full max-w-md cursor-pointer rounded-[1.75rem] bg-panel-2 p-4" onClick={toggle})
          ViewTransition(name="b-card-art" share={ART})
            div(className="art art-2 h-44 rounded-[1.25rem]")
          div(className="flex items-end justify-between gap-2 md:gap-4 px-2 pt-5")
            ViewTransition(name="b-card-title" share="glide")
              h3(className="m-0 text-base md:text-2xl font-medium tracking-[-0.03em]") Harbour 6:12 PM
            span(className='chip') 35mm
          p(className="m-0 px-2 pt-3 pb-2 text-xs md:text-sm leading-relaxed text-muted") Low tide, cold light, one ferry waiting. The same element, re-laid out — one snapshot, clipped to the box as it grows.
      else
        article(className="flex w-72 cursor-pointer items-center gap-3 rounded-3xl bg-panel-2 p-2 pr-6" onClick={toggle})
          ViewTransition(name="b-card-art" share={ART})
            div(className="art art-2 size-14 rounded-2xl")
          ViewTransition(name="b-card-title" share="glide")
            h3(className="m-0 text-base font-medium") Harbour at 6:12 PM
  button(type="button" aria-pressed={open} onClick={toggle} className='vt-btn') #{open ? "collapse" : "expand"}
