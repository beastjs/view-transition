import { ViewTransition, startTransition, useState } from "octane";
module
  type SortKey = "joined" | "name" | "role";
  interface Person { id: number; name: string; role: string; joined: number }
  const PEOPLE: Person[] = [
    { id: 1, name: "Mira Okafor", role: "design", joined: 2014 },
    { id: 2, name: "Jun Takeda", role: "engineering", joined: 2019 },
    { id: 3, name: "Alba Ruiz", role: "strategy", joined: 2011 },
    { id: 4, name: "Theo Laine", role: "motion", joined: 2022 },
    { id: 5, name: "Sana Iqbal", role: "research", joined: 2016 }
  ];
  const KEYS: SortKey[] = ["joined", "name", "role"];
  const sortBy = (key: SortKey) => [...PEOPLE].sort((a, b) => key === "joined" ? a.joined - b.joined : a[key].localeCompare(b[key]));
  // Which way each row travels: rows moving up "lift", rows moving down "dip".
  function directions(from: Person[], to: Person[]): Record<number, string> {
    const moves: Record<number, string> = {};
    to.forEach((person, index) => {
      const before = from.findIndex((p) => p.id === person.id);
      moves[person.id] = index < before ? "lift" : index > before ? "dip" : "glide";
    });
    return moves;
  }

setup const [sortKey, setSortKey] = useState<SortKey>("joined");
setup const [moves, setMoves] = useState<Record<number, string>>({});
setup const sorted = sortBy(sortKey);
setup
  const sort = (next: SortKey) => {
    if (next === sortKey) return;
    startTransition(() => {
      setMoves(directions(sorted, sortBy(next)));
      setSortKey(next);
    });
  };

div(className="w-full max-w-md")
  div(className="flex flex-wrap gap-2 pb-5")
    each option in KEYS key option
      button.vt-btn(type="button" aria-pressed={sortKey === option} onClick={() => sort(option)}) #{option}
  ol(className="m-0 flex list-none flex-col p-0")
    each person, index in sorted key person.id
      // The rows (and their lines) stay put; only the text inside is captured.
      // A stable name per person lets it travel to its new slot, and the class
      // adds depth to the move.
      // The slot number belongs to the row, not the person, so it stays too.
      li(className="grid grid-cols-[2rem_1fr] items-baseline gap-3 border-b border-line py-3")
        span(className="font-mono text-xs text-muted") #{String(index + 1).padStart(2, "0")}
        ViewTransition(name={`b-row-${person.id}`} update={moves[person.id] ?? "glide"})
          div(className="flex items-baseline justify-between gap-3")
            span(className="text-lg tracking-[-0.02em]") #{person.name}
            span(className="text-sm text-muted") #{person.role} · #{person.joined}
