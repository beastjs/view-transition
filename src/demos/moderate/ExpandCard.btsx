import { ViewTransition, startTransition, useState } from "octane";
module
  interface Card { id: number; title: string; kicker: string; art: string; body: string }
  const CARDS: Card[] = [
    { id: 1, title: "Special View", kicker: "media · a11y", art: "art-1", body: "A media platform for blind readers, built to accessibility standards first and visual polish second — and it still looks like this." },
    { id: 2, title: "Ladya", kicker: "branding", art: "art-3", body: "Rebranding a furniture factory from heritage to modern without losing the grain of the wood." },
    { id: 3, title: "Astroverts", kicker: "ux · seo", art: "art-2", body: "A science travel club site that sells curiosity first and itineraries second." }
  ];

setup const [selected, setSelected] = useState<number | null>(null);
setup const select = (id: number | null) => startTransition(() => setSelected(id));

div(className="grid w-full grid-cols-1 gap-3 sm:grid-cols-3")
  each card in CARDS key card.id
    if selected === card.id
      // Outer name morphs the frame; nested names move art + title on their own paths.
      ViewTransition(name={`m-card-${card.id}`} share="morph" update="morph")
        article(className="col-span-full grid cursor-pointer gap-5 rounded-[1.75rem] bg-panel-2 p-4 sm:grid-cols-[1.1fr_1fr]" onClick={() => select(null)})
          ViewTransition(name={`m-card-art-${card.id}`} share="morph")
            div(className={`art ${card.art} min-h-52 rounded-[1.25rem]`})
          div(className="flex flex-col gap-3 p-2")
            ViewTransition(name={`m-card-title-${card.id}`} share="glide")
              h3(className="m-0 text-3xl font-medium tracking-[-0.04em]") #{card.title}
            span.eyebrow #{card.kicker}
            p(className="m-0 text-sm leading-relaxed text-muted") #{card.body}
            span(className="mt-auto text-xs text-muted") click to close
    else
      ViewTransition(name={`m-card-${card.id}`} share="morph" update="glide")
        article(className="cursor-pointer rounded-[1.5rem] bg-panel-2 p-3 transition-colors hover:bg-panel" onClick={() => select(card.id)})
          ViewTransition(name={`m-card-art-${card.id}`} share="morph")
            div(className={`art ${card.art} h-28 rounded-[1.1rem]`})
          ViewTransition(name={`m-card-title-${card.id}`} share="glide")
            h3(className="m-0 px-1 pt-3 text-lg font-medium tracking-[-0.02em]") #{card.title}
