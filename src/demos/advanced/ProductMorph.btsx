import { ViewTransition, addTransitionType, flushSync, startTransition, useState } from "octane";
import type { ViewTransitionInstance } from "octane";
module
  interface Product { id: number; name: string; price: number; tag: string; art: string; blurb: string }
  const PRODUCTS: Product[] = [
    { id: 1, name: "Orbit lamp", price: 240, tag: "lighting", art: "art-1", blurb: "Hand-spun aluminium with a dimmable warm core. Throws a halo, not a glare." },
    { id: 2, name: "Tide chair", price: 590, tag: "seating", art: "art-2", blurb: "Steam-bent ash and waxed canvas. Sits low, reads well from across the room." },
    { id: 3, name: "Bloom vase", price: 85, tag: "objects", art: "art-3", blurb: "Glazed stoneware with a conic finish no two kilns agree on." },
    { id: 4, name: "Dusk rug", price: 420, tag: "textiles", art: "art-4", blurb: "Undyed wool, hand-knotted. Gets better with every muddy boot." }
  ];
  interface BagItem { key: number; art: string }

  // View transitions travel in straight lines. onShare hands us the running
  // group animation, so we rewrite its keyframes into an L-shaped path:
  //   1 · rise straight up while shrinking around its own centre, arriving
  //       level with the bag already at its final size;
  //   2 · slide right along that line into the bag.
  // Duration is whatever CSS resolved, so slow-mo and reduced motion still apply.
  function flightPath(instance: ViewTransitionInstance) {
    const [move] = instance.group.getAnimations();
    const effect = move?.effect as KeyframeEffect | undefined;
    if (!effect || Number(effect.getComputedTiming().duration) < 50) return;
    const [from, to] = effect.getKeyframes();
    const a = new DOMMatrix(String(from.transform)), b = new DOMMatrix(String(to.transform));
    const px = (value: unknown) => parseFloat(String(value));
    // keep the horizontal centre while shrinking, land on the bag's row
    const x = a.e + (px(from.width) - px(to.width)) / 2;
    effect.setKeyframes([
      { ...from, offset: 0, easing: "cubic-bezier(0.3, 0, 0.2, 1)" },
      { offset: 0.55, transform: `matrix(1, 0, 0, 1, ${x}, ${b.f})`, width: to.width, height: to.height, easing: "cubic-bezier(0.45, 0, 0.2, 1)" },
      { ...to, offset: 1 }
    ]);
    effect.updateTiming({ easing: "linear" });
  }

module
  interface ProductItemProps {
    product: Product
    open: (id: number | null) => void
    add: () => void
    launching: boolean
    tokenKey: number
  }

component ProductItem
  props { product, open, add, launching, tokenKey }: ProductItemProps
  // No wrapper boundary around the view: shared names pair reliably only when
  // they aren't nested inside a boundary that is itself entering or exiting.
  article(className="grid gap-6 sm:grid-cols-[1fr_1fr]")
    div(className="relative")
      // The image grows out of its grid card as one cropped picture.
      ViewTransition(name={`a-prod-art-${product.id}`} share="grow round-20")
        div(className={`art ${product.art} aspect-[4/5] rounded-[1.25rem]`})
      // "Add to bag" first paints an exact copy over the image (no visible
      // change), then moves the copy's name into the bag — so it can fly.
      if launching
        ViewTransition(name={`a-bag-token-${tokenKey}`} share="fly" onShare={flightPath})
          div(className={`art ${product.art} absolute inset-0 rounded-[1.25rem]`})
    div(className="flex flex-col gap-4 py-2")
      ViewTransition(enter="fade" exit="fade")
        button(type="button" className="vt-btn self-start" onClick={() => open(null)}) ← all objects
      // Tag, name and price zoom between sizes as single crisp pieces of text;
      // w-fit keeps each box hugging its text so the zoom stays proportional.
      ViewTransition(name={`a-prod-tag-${product.id}`} share="text-zoom")
        span(className="chip self-start") #{product.tag}
      ViewTransition(name={`a-prod-name-${product.id}`} share="text-zoom")
        h3(className="m-0 w-fit text-4xl font-medium tracking-[-0.045em]") #{product.name}
      ViewTransition(name={`a-prod-price-${product.id}`} share="text-zoom")
        span(className="w-fit font-mono text-lg") €#{product.price}
      // Content that exists only on the detail page rises in after the morph.
      ViewTransition(enter="rise" exit="fade")
        div(className="flex flex-col gap-5")
          p(className="m-0 text-sm leading-relaxed text-muted") #{product.blurb}
          button(type="button" className="vt-btn self-start bg-accent text-white" style={{ borderColor: "transparent" }} onClick={add}) Add to bag

module
  interface ProductListProps {
    open: (id: number | null) => void
  }

module
  interface ListProps {
    open: (id: number | null) => void
  }

component List
  props { open }: ListProps
  ul(className="m-0 grid list-none grid-cols-2 gap-3 p-0 md:grid-cols-4")
    each item in PRODUCTS key item.id
      li
        button(type="button" className="vt-focus flex w-full cursor-pointer flex-col gap-2 border-0 bg-transparent p-0 text-left" onClick={() => open(item.id)})
          // The opened product shares these names with the detail view; the
          // other products sink out on open and rise back in on close.
          ViewTransition(name={`a-prod-art-${item.id}`} share="shrink round-20" enter="rise" exit="sink")
            div(className={`art ${item.art} aspect-[4/5] w-full rounded-[1.25rem]`})
          ViewTransition(name={`a-prod-tag-${item.id}`} share="text-zoom" enter="rise" exit="sink")
            span(className='chip self-start') #{item.tag}
          ViewTransition(name={`a-prod-name-${item.id}`} share="text-zoom" enter="rise" exit="sink")
            span(className="w-fit text-base font-medium") #{item.name}
          ViewTransition(name={`a-prod-price-${item.id}`} share="text-zoom" enter="rise" exit="sink")
            span(className="w-fit font-mono text-xs text-muted") €#{item.price}

component ProductList
  props { open }: ProductListProps
  List(open={open})

setup const [openId, setOpenId] = useState<number | null>(null);
setup const [bag, setBag] = useState<BagItem[]>([]);
setup const [launching, setLaunching] = useState(false);
setup const product = PRODUCTS.find((item) => item.id === openId) ?? null;
setup const last = bag.at(-1) ?? null;
setup
  const open = (id: number | null) => startTransition(() => {
    addTransitionType(id === null ? "close" : "open");
    setOpenId(id);
  });
  const addToBag = (item: Product) => {
    // 1 · urgently paint the launch copy, so the old snapshot contains it
    flushSync(() => setLaunching(true));
    // 2 · in one transition: the copy leaves the image, the bag receives it
    startTransition(() => {
      addTransitionType("add-to-bag");
      setBag((list) => [...list, { key: list.length, art: item.art }]);
      setLaunching(false);
    });
  };

div(className="w-full")
  div(className="flex items-center justify-between pb-5")
    span.eyebrow objects
    // The bag bumps and its count rolls only when something lands in it.
    ViewTransition(name="a-bag" update={{ "add-to-bag": "bump", default: "none" }})
      div(className="flex items-center gap-2 rounded-full border border-line py-1 pr-4 pl-1")
        div(className="size-7")
          if last
            // The newest item takes the flying picture's name, so it lands here.
            // Keyed per item: each add is a real exit + enter, not a rename.
            each item in [last] key item.key
              ViewTransition(name={`a-bag-token-${item.key}`} share="fly" exit="fade")
                div(className={`art ${item.art} size-7 rounded-full`})
          else
            div(className="size-7 rounded-full border border-dashed border-line")
        span(className="text-sm") bag
        ViewTransition(name="a-bag-count" update={{ "add-to-bag": "roll-up late", default: "none" }})
          span(className="min-w-[1ch] font-mono text-sm tabular-nums") #{bag.length}
  if product
    // Four shared names, one per fact: image, name, price, tag.
    ProductItem(product={product} open={open} add={() => addToBag(product)} launching={launching} tokenKey={bag.length})
  else
    ProductList(open={open})
