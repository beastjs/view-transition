import { ViewTransition, addTransitionType, startTransition, useRef, useState } from "octane";
module
  interface Step { id: string; title: string; prompt: string; options: string[] }
  const STEPS: Step[] = [
    { id: "brief", title: "The brief", prompt: "What are we making?", options: ["website", "product", "brand"] },
    { id: "audience", title: "Audience", prompt: "Who is it for?", options: ["shoppers", "readers", "teams"] },
    { id: "tone", title: "Tone", prompt: "How should it feel?", options: ["calm", "bold", "playful"] },
    { id: "launch", title: "Launch", prompt: "When does it ship?", options: ["this month", "this quarter", "no rush"] }
  ];
  // The step leaves and arrives piece by piece. Each piece is its own
  // boundary, and the w1–w5 classes wait their turn. Continue:
  //      0 choices out
  //    680 answer slides to the column's left edge and through it
  //    760 question push: the new one slides in and shoves the old one out
  //   1100 new choices in + answer out of the list portal
  //   1540 the answer's step title rises
  // Back plays it mirrored.
  // The counter rolls last, once everything else has settled: after the
  // title rises (continue, w6 = 2080ms) or the answer re-emerges (back, w7 = 1640ms).
  const COUNT = { forward: "roll-up w6 linger", backward: "roll-down w7 linger", default: "none" };
  const CHOICE_OUT = { forward: "step-to-left", backward: "step-to-right", default: "none" };
  // The question holds until its replacement is ready, then the new one
  // pushes it out: same distance, curve and start, so their edges touch.
  const QUESTION_OUT = { forward: "push-to-left w3", backward: "push-to-right w3", default: "none" };
  const QUESTION_IN = { forward: "push-from-right w3", backward: "push-from-left w3", default: "none" };
  const CHOICE_IN = { forward: "slide-from-right w4", backward: "slide-from-left w4", default: "none" };
  // The selected answer leaves through its own left edge once the question is
  // gone; on the way back it emerges from that edge again.
  const ANSWER_OUT = { forward: "portal-far-to-left w2", backward: "step-to-right", default: "none" };
  const ANSWER_IN = { forward: "slide-from-right w4", backward: "portal-far-from-left w4", default: "none" };

  // How far the selected answer sits from the step column's left edge — the
  // portal. Written to <html> because transition pseudo-elements inherit from
  // it, which is how the CSS reaches this per-element distance.
  function measurePortal(variable: string, column: HTMLElement | null) {
    const answer = column?.querySelector<HTMLElement>("[data-answer]");
    if (!column || !answer) return;
    const dx = answer.getBoundingClientRect().left - column.getBoundingClientRect().left;
    document.documentElement.style.setProperty(variable, `${Math.max(0, dx)}px`);
  }
  // ...and the list chip is the other end of the portal.
  const CHIP_IN = { forward: "portal-from-right w4", default: "fade" };
  const CHIP_OUT = { backward: "portal-to-right w1", default: "fade" };

module
  interface WizardListProps {
    step: number
    done: boolean
  }

component WizardList
  props { step, done }: WizardListProps
  ol(className="m-0 grid list-none grid-cols-4 gap-2 p-0")
    each s, i in STEPS key s.id
      li(className="relative flex flex-col gap-2")
        span(className={`text-xs whitespace-nowrap ${i <= step ? "text-ink" : "text-muted"}`}) #{i < step ? "✓" : ' '} #{s.title}
        div(className="relative h-1 rounded-full bg-panel-2")
          if i === Math.min(step, STEPS.length - 1)
            // One marker, shared across the four tracks.
            ViewTransition(name="a-wiz-marker" share="glide")
              span(className={`absolute inset-0 rounded-full ${done ? "bg-ink" : "bg-accent"}`})

module
  interface WizardSectionProps {
    step: number
    answers: Record<string, string>
    choose: (id: string, option: string) => void
    column: { current: HTMLElement | null }
  }

module
  interface WizardStepProps {
    s: Step
    answers: Record<string, string>
    choose: (id: string, option: string) => void
    column: { current: HTMLElement | null }
  }

component WizardStep
  props { s, answers, choose, column }: WizardStepProps
  // No boundary around the whole step: a leaving block only animates its
  // outermost boundary, so each piece gets its own to be staggered.
  section(className="absolute inset-0 flex flex-col gap-4")
    if s
      fragment
        ViewTransition(enter={QUESTION_IN} exit={QUESTION_OUT})
          h3(className="m-0 text-lg md:text-3xl font-medium tracking-[-0.04em]") #{s.prompt}
        div(className="flex flex-wrap gap-2")
          each option in s.options key option
            if answers[s.id] === option
              // Selected: waits for the choices and question to clear, then
              // slips out through the left portal.
              // Coming back, measure where it landed so it can emerge from the
              // column's edge (its entrance waits until w4, after this runs).
              ViewTransition(enter={ANSWER_IN} exit={ANSWER_OUT} onEnter={() => measurePortal("--portal-in-dx", column.current)})
                button.vt-btn(type="button" aria-pressed={true} data-answer) #{option}
            else
              ViewTransition(enter={CHOICE_IN} exit={CHOICE_OUT})
                button.vt-btn(type="button" aria-pressed={false} onClick={() => choose(s.id, option)}) #{option}
    else
      fragment
        ViewTransition(enter={QUESTION_IN} exit={QUESTION_OUT})
          h3(className="m-0 text-lg md:text-3xl font-medium tracking-[-0.04em]") Brief ready.
        ViewTransition(enter={CHOICE_IN} exit={CHOICE_OUT})
          p(className="m-0 text-sm leading-relaxed text-muted") A #{answers.tone ?? "calm"} #{answers.brief ?? "website"} for #{answers.audience ?? "shoppers"}, shipping #{answers.launch ?? "this quarter"}.

component WizardSection
  props { step, answers, choose, column }: WizardSectionProps
  div(className="relative h-40")
    each s in [STEPS[step] ?? null] key s?.id ?? "summary"
      WizardStep(s={s} answers={answers} choose={choose} column={column})

setup const [step, setStep] = useState(0);
setup const [answers, setAnswers] = useState<Record<string, string>>({});
setup const column = useRef<HTMLElement | null>(null);
setup
  const go = (delta: number) => {
    // Leaving forward, measure the answer's distance to the portal (the
    // column's left edge) while it is still on screen.
    if (delta > 0) measurePortal("--portal-out-dx", column.current);
    startTransition(() => {
      const target = Math.min(STEPS.length, Math.max(0, step + delta));
      addTransitionType(delta > 0 ? "forward" : "backward");
      setStep(target);
      // Going back keeps the answer you return to, and clears everything after
      // it — so continuing again always lands on a fresh, unselected step.
      if (delta < 0) {
        setAnswers((current) => Object.fromEntries(STEPS.slice(0, target + 1).filter((s) => s.id in current).map((s) => [s.id, current[s.id]])));
      }
    });
  };
  // Selecting is instant — no transition. The motion happens on continue/back.
  const choose = (id: string, option: string) => setAnswers((current) => ({ ...current, [id]: option }));
  const done = step === STEPS.length;

div(className="grid w-full max-w-xl md:max-w-3xl gap-6 md:gap-8 md:grid-cols-[minmax(0,1fr)_11rem]")
  div(ref={column} className="flex min-w-0 flex-col gap-4 md:gap-6")
    WizardList(step={step} done={done})
    // Only the number rolls — up on continue, down on back — like the basic
    // counter, as the final beat of the transition.
    if done
      ViewTransition(enter="fade" exit="fade")
        span(className="font-mono text-xs text-muted") complete
    else
      span(className="flex gap-[1ch] font-mono text-xs text-muted")
        span step
        ViewTransition(name="a-wiz-count" update={COUNT})
          span(className="inline-block tabular-nums") #{step + 1}
        span of #{STEPS.length}
    WizardSection(step={step} answers={answers} choose={choose} column={column})
    div(className="flex justify-between")
      button.vt-btn(type="button" disabled={step === 0} onClick={() => go(-1)}) ← back
      if done
        button.vt-btn(type="button" onClick={() => startTransition(() => { addTransitionType("backward"); setStep(0); setAnswers({}); })}) start over
      else
        button.vt-btn(type="button" aria-pressed={true} disabled={!answers[STEPS[step].id]} onClick={() => go(1)}) #{step === STEPS.length - 1 ? "finish" : "continue →"}
  // Completed steps only — nothing is shown for a step until it is answered.
  // The chip is the far side of the portal: it slides in from its right edge
  // after the answer vanished on the left. The step title rises once the chip
  // is in (w5), and slides away first when going back.
  aside(className="flex flex-col")
    ol(className="m-0 flex list-none md:flex-col -gap-2 md:gap-3 p-0")
      each s, i in STEPS key s.id
        if i < step && answers[s.id]
          li(className="flex flex-col items-start gap-1.5 md:scale-100 scale-70")
            ViewTransition(enter="slide-up w5" exit="slide-away")
              span(className="text-sm text-muted pb-2") #{s.title}
            ViewTransition(enter={CHIP_IN} exit={CHIP_OUT})
              span(className="vt-btn cursor-default border-ink bg-ink text-paper") #{answers[s.id]}
