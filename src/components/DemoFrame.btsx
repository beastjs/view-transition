import { ViewTransition, startTransition, useMemo, useState } from "octane";
import type { Demo } from "@/demos";
import { highlight } from "@/lib/highlight";
module
  type View = "preview" | "btsx" | 'tsrx' | 'css';
  const VIEWS: View[] = ["preview", "btsx"];

props { demo, number }: { demo: Demo; number: string }
setup const [view, setView] = useState<View>("preview");
setup const html = useMemo(() => highlight(demo.source));
setup const Stage = demo.component;
setup const show = (next: View) => startTransition(() => setView(next));

// Fills the demo panel: info on the left, the stage stretching to the bottom
// on the right. On narrow screens they stack and the frame scrolls inside.
article(id={demo.id} className="flex h-full min-h-0 flex-col gap-6 overflow-y-auto py-6 lg:grid lg:grid-cols-[minmax(0,4fr)_minmax(0,8fr)] lg:gap-14 lg:overflow-visible lg:py-8")
  header(className="flex shrink-0 flex-col gap-4")
    // span(className="font-thin text-xs text-muted/50") #{number}
    h3(className="m-0 text-[clamp(1.9rem,3.2vw,2.8rem)] font-medium leading-[1.02] tracking-[-0.045em]") #{demo.title}
    p(className="hidden md:inline m-0 max-w-md text-sm leading-relaxed text-muted") #{demo.blurb}
    ul(className="hidden md:flex m-0 list-none flex-wrap gap-2 p-0" aria-label="APIs used")
      each api in demo.apis key api
        li.chip #{api}
    // p(className="m-0 pt-2 font-mono text-[0.7rem] text-muted") ↳ #{demo.origin}
  div(className="flex md:min-h-[42rem] min-w-0 flex-1 flex-col overflow-hidden border border-line rounded-[1.75rem] bg-panel lg:min-h-0")
    div(className="flex shrink-0 items-center justify-between gap-4 border-b border-line/50 py-2 pr-5 pl-2")
      div(className="flex gap-1" role="tablist" aria-label={`${demo.title} view`})
        each option in VIEWS key option
          button(
            ~ type="button"
            ~ role="tab"
            ~ aria-selected={view === option}
            ~ className={`vt-focus cursor-pointer rounded-full border-0 px-4 py-2 text-sm transition-colors ${view === option ? "bg-panel-2 text-ink" : "bg-transparent text-muted hover:text-ink"}`}
            ~ onClick={() => show(option)}
            ~ )
            | #{option}
      // code(className="hidden truncate font-mono text-[0.7rem] text-muted sm:block") #{demo.file}
      code(className="hidden truncate font-mono text-[0.7rem] text-muted sm:block capitalize") #{demo.origin}
    // update="none": the demo's own boundaries animate inside, the frame never does.
    if view === "preview"
      ViewTransition(enter="glide" exit="fade" update="none")
        div(className="grid min-h-0 flex-1 place-items-start overflow-auto p-6 sm:p-10")
          Stage
    else
      ViewTransition(enter="fade" exit="fade" update="none")
        pre(className="m-0 min-h-0 flex-1 overflow-auto p-6 text-[0.78rem] leading-[1.7]")
          code(className="font-mono [font-variant-ligatures:none]" dangerouslySetInnerHTML={{ __html: html }})
